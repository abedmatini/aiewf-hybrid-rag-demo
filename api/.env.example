DATABASE_URL=postgresql://chainlit:chainlit@localhost:5435/chainlit_db
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3:latest
EMBED_DIM=1024
# Local vision model for admin screenshot OCR (ollama pull qwen2.5vl)
VISION_MODEL=qwen2.5vl
# Seconds to wait for vision OCR per image
VISION_TIMEOUT=180
CHAT_MODEL=medgemma:latest
# Model for agent tool calling (search_kb, calculate, etc.). Start with the
# smallest (qwen2.5:0.5b) — retrieval + guardrails do most of the work, so a
# tiny model is usually enough. Upgrade to qwen2.5:7b-instruct only if you see
# tool-calling reliability issues.
AGENT_MODEL=qwen2.5:0.5b
# Small model used only for the Tier 3 YES/NO medical classifier.
# Set to "none" to disable LLM-based classification (Tiers 1+2 only).
# Start with qwen2.5:0.5b; qwen2.5:7b-instruct is a fallback for better accuracy.
CLASSIFIER_MODEL=qwen2.5:0.5b
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5173
KB_USER_ID=faq_kb
# Guardrail pack: health_faq | health | hr | ecommerce (see HARNESS_ARCHITECTURE.md).
# health_faq's Tier 1 regex blocks first-person phrasing like "do I have..." even on
# non-health content — set to "ecommerce" if your KB docs aren't health-related.
DOMAIN=health_faq
# Ollama generation context window. Increase for larger models with more RAM.
OLLAMA_NUM_CTX=8192
# Cosine distance threshold for off-topic detection (0-2, lower = stricter).
CHITCHAT_DISTANCE_THRESHOLD=0.70
# Max conversation turns kept in context (each turn = 2 messages).
MAX_HISTORY=20
# API_KEY=changeme   # uncomment and set before staging deploy
# Langfuse tracing (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Cross-encoder reranker (optional — leave blank to disable, adds ~200-400 ms per query when set)
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=
