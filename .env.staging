# ─────────────────────────────────────────────────────────────────────────────
# FAQ Agentic — Staging environment variables
# Copy this file to .env and fill in real values before deploying.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=faq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=faq_db

# ── Ollama models (GT730 = CPU-only; lower OLLAMA_NUM_CTX saves RAM) ─────────
EMBED_MODEL=bge-m3:latest
EMBED_DIM=1024
CHAT_MODEL=qwen2.5:0.5b
CLASSIFIER_MODEL=qwen2.5:0.5b
# Context window — 0.5b model is fast so 4096 is fine
OLLAMA_NUM_CTX=4096

# ── API ───────────────────────────────────────────────────────────────────────
# Per-deployment domain pack: health | hr | ecommerce (exactly one per install)
DOMAIN=health
# Tier-3 guard model — pull with: docker exec -it faq_ollama ollama pull llama-guard3:1b
GUARD_MODEL=llama-guard3:1b
# Comma-separated list of allowed CORS origins (your staging domain)
CORS_ORIGINS=http://YOUR_STAGING_DOMAIN,https://YOUR_STAGING_DOMAIN
KB_USER_ID=faq_kb
CHITCHAT_DISTANCE_THRESHOLD=0.70
MAX_HISTORY=10
# Uncomment and set a strong random string before deploying
API_KEY=CHANGE_ME_API_KEY
# Agent tool-calling model (must support Ollama native function calling)
AGENT_MODEL=qwen2.5:0.5b
MAX_AGENT_ITERATIONS=5

# ── Optional: cross-encoder reranker (adds ~200-400ms, not recommended on CPU) ─
RERANKER_MODEL=

# ── Optional: Langfuse tracing ────────────────────────────────────────────────
# Langfuse DB password (internal service, change it)
LANGFUSE_DB_PASSWORD=CHANGE_ME_LANGFUSE_DB_PASSWORD
# Public URL of Langfuse for NextAuth (use your VPS IP or domain)
LANGFUSE_NEXTAUTH_URL=http://YOUR_VPS_IP:3000
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
LANGFUSE_SALT=CHANGE_ME_SALT
# After creating a project in the Langfuse dashboard, fill these in:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Point the API at the internal service name
LANGFUSE_HOST=http://langfuse:3000

# ── UI (baked into the React build at image build time) ──────────────────────
# Use /api to route through the nginx proxy (recommended)
VITE_API_URL=/api
VITE_PRIVACY_POLICY_URL=https://example.com/privacy-policy
# Leave blank to disable GA4 cookie banner
VITE_GA4_ID=
